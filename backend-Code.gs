const WRITE_ACTIONS = ["login","logout","saveSong","songOp","deleteSong","saveTask","commentTask","deleteTask","rsvp","saveSession","deleteSession","saveProtocol","exportProtocol","addIdea","promoteIdea","saveProject","saveInvoice","deleteInvoice","setStartBalance","saveVision","setAvatar","addPrayer","reactPrayer","commentPrayer","answeredPrayer","editPrayer","deletePrayer","saveMember","invite"];
const PUBLIC_ACTIONS = ["ping","login","names"];

/* ---------------- HTTP ---------------- */
function handle_(body) {
  const action = body && body.action;
  const fn = ACTIONS[action];
  if (!fn) return { ok: false, error: "bad_request", message: "Unbekannte Aktion." };
  const write = WRITE_ACTIONS.indexOf(action) >= 0;
  const lock = write ? LockService.getScriptLock() : null;
  try {
    if (lock) lock.waitLock(20000);
    const me = PUBLIC_ACTIONS.indexOf(action) >= 0 ? null : memberByToken_(body.token);
    return { ok: true, data: fn(body, me) };
  } catch (e) {
    return { ok: false, error: e.code || "server", message: e.code ? e.message : "Serverfehler: " + e.message };
  } finally {
    if (lock) try { lock.releaseLock(); } catch (e) {}
  }
}
function json_(o) { return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function doGet() { return json_({ ok: true, data: ACTIONS.ping() }); }
function doPost(e) {
  let body = {};
  try { body = JSON.parse((e && e.postData && e.postData.contents) || "{}"); }
  catch (x) { return json_({ ok: false, error: "bad_request", message: "Ungültige Anfrage." }); }
  return json_(handle_(body));
}

/* ---------------- one time setup (run by hand in the editor) ---------------- */
function setup() {
  if (P.getProperty("SHEET_ID")) throw new Error("Schon eingerichtet. Nichts wurde verändert. SHEET_ID: " + P.getProperty("SHEET_ID"));
  const leitung = DriveApp.createFolder("Raum Leitung");
  const rechnungen = leitung.createFolder("Rechnungen");
  const book = SpreadsheetApp.create("Raum Worship Hub Daten");
  DriveApp.getFileById(book.getId()).moveTo(leitung);
  Object.keys(FIELDS).forEach((name, i) => {
    const sh = i === 0 ? book.getSheets()[0].setName(name) : book.insertSheet(name);
    sh.getRange(1, 1, sh.getMaxRows(), FIELDS[name].length).setNumberFormat("@");
    sh.getRange(1, 1, 1, FIELDS[name].length).setValues([FIELDS[name]]).setFontWeight("bold");
    sh.setFrozenRows(1);
  });
  P.setProperties({ SHEET_ID: book.getId(), LEITUNG_FOLDER: leitung.getId(), INVOICE_FOLDER: rechnungen.getId() });

  const D = seed();
  const sys = { id: "setup" };
  D.ideas = [];                                   // the prototype example idea is not real data
  D.sessions.forEach(s => { s.rsvp = {}; });      // prototype sample answers are not real
  D.members.forEach(m => { m.active = true; m.token_hashes = []; put_("members", stamp_(m, sys)); });
  D.songs.forEach(s => put_("songs", stamp_(s, sys)));
  D.tasks.forEach(t => put_("tasks", stamp_(t, sys)));
  D.sessions.forEach(s => put_("sessions", stamp_(s, sys)));
  D.projects.forEach(p => put_("projects", stamp_(p, sys)));
  D.money.invoices.forEach(r => put_("invoices", stamp_(r, sys)));
  setting_("start_balance", D.money.start);
  setting_("start_note", D.money.startNote);

  const oti = get_("members", "oti");
  const code = makeInvite_(oti);
  put_("members", oti);
  log_(null, "setup", "all", "", "Sheet, Ordner und Startdaten angelegt");
  Logger.log("Fertig. Sheet: " + book.getUrl());
  Logger.log("Ordner Raum Leitung: " + leitung.getUrl());
  Logger.log("Erster Code für Oti (14 Tage gültig): " + code);
  return { sheet: book.getUrl(), code: code };
}

